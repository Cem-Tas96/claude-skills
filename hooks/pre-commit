#!/bin/sh
# ============================================================================
# Globaler Secret-Scanning pre-commit Hook  —  Cem-Tas96/claude-skills
# ----------------------------------------------------------------------------
# Blockiert JEDEN Commit (in JEDEM Repo auf diesem Rechner), der Credentials,
# Keys oder gefaehrliche Dateien einfuehrt. Aktiviert via globalem core.hooksPath
# (siehe install.sh / install.ps1). Gilt fuer Claude UND fuer manuelle Commits.
#
# Personal-Denylist (eigene IPs/Hosts, literal, eine pro Zeile):
#     ~/.config/git/secret-denylist.local.txt   (NIE eingecheckt)
#
# Falsch-Positiv?  -> "pragma: allowlist secret" an die Zeile schreiben,
#                     oder einmalig umgehen mit:  git commit --no-verify
# ============================================================================
set -u

staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
[ -z "$staged" ] && exit 0

RED=$(printf '\033[31m'); YEL=$(printf '\033[33m'); NC=$(printf '\033[0m')
violations=0
report() { printf '%s%s%s\n' "$RED" "BLOCKED: $1" "$NC"; violations=$((violations+1)); }

# Pfade, die der Scanner ueberspringt (sonst triggert er auf seinen eigenen
# Pattern-Definitionen).
is_excluded() {
  case "$1" in
    hooks/*|*/hooks/*|*secret-denylist*|install.sh|*/install.sh|install.ps1|*/install.ps1) return 0;;
    *) return 1;;
  esac
}

# --- 1. Gefaehrliche Dateinamen ---------------------------------------------
for f in $staged; do
  is_excluded "$f" && continue
  base=$(basename "$f")
  case "$base" in
    .env.example|.env.sample|.env.template|.env.dist|.env.*.example) : ;;
    .env|.env.*) report "Dotenv mit echten Werten? -> $f";;
  esac
  case "$base" in
    id_rsa|id_dsa|id_ecdsa|id_ed25519|*.pem|*.p12|*.pfx|*.keystore|*.jks|*.ppk|*.pkcs12)
      report "Private-Key / Keystore -> $f";;
    *.mv.db|*.sqlite|*.sqlite3|*.db)
      report "Datenbank-Datei (kann Secrets enthalten — domoAI-Lehre) -> $f";;
    credentials.json|service-account*.json|*serviceaccount*.json)
      report "Credential-Datei -> $f";;
  esac
done

# --- 2. Inhalts-Scan (nur hinzugefuegte Zeilen) -----------------------------
added=$(
  for f in $staged; do
    is_excluded "$f" && continue
    git diff --cached --unified=0 -- "$f" 2>/dev/null
  done | grep -E '^\+' | grep -vE '^\+\+\+'
)
# allowlisted Zeilen rausfiltern
added=$(printf '%s\n' "$added" | grep -vi 'pragma: allowlist secret' 2>/dev/null || true)

# check <Label> <grep-flags> <ERE>
check() {
  label=$1; flags=$2; pat=$3
  hit=$(printf '%s\n' "$added" | grep $flags "$pat" 2>/dev/null || true)
  if [ -n "$hit" ]; then
    report "$label"
    printf '%s\n' "$hit" | cut -c1-160 | sed 's/^/    /'
  fi
}

check "Private-Key-Block"             -E  '-----BEGIN[ A-Z]*PRIVATE KEY-----'
check "AWS Access Key ID"             -E  'A(KIA|SIA|GPA|IDA|ROA|IPA|NPA|NVA)[0-9A-Z]{16}'
check "GitHub Token"                  -E  '((ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,})|(github_pat_[A-Za-z0-9_]{30,})'
check "GitLab Token"                  -E  'glpat-[A-Za-z0-9_-]{20,}'
check "Slack Token"                   -E  'xox[baprs]-[A-Za-z0-9-]{10,}'
check "Google API Key"               -E  'AIza[0-9A-Za-z_-]{35}'
check "SendGrid Key"                  -E  'SG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}'
check "Stripe Secret/Restricted Key"  -E  '(sk|rk)_live_[0-9a-zA-Z]{16,}'
check "Stripe Webhook Secret"         -E  'whsec_[0-9a-zA-Z]{16,}'
check "OpenAI/Anthropic Key"          -E  'sk-(ant-)?[A-Za-z0-9_-]{20,}'
check "Twilio Account SID"            -E  'AC[0-9a-f]{32}'
check "JWT (moeglich)"                -E  'eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}'

# Generische Credential-Zuweisung (mit Placeholder-Ausschluss, FP-arm)
GEN_EXCL='xxx+|your[-_]|example|placeholder|changeme|dummy|redacted|sample|<[^>]+>|\$\{|process\.env|os\.environ|getenv|import\.meta\.env|REPLACE|TODO|FIXME|\*\*\*|=$|: *$'
GEN_KW='(password|passwd|pwd|secret|api[_-]?key|access[_-]?key|client[_-]?secret|auth[_-]?token|private[_-]?key)[a-z0-9_]*'
gen=$(printf '%s\n' "$added" \
  | grep -inE "$GEN_KW[[:space:]]*[=:][[:space:]]*(\"[^\"]{12,}\"|'[^']{12,}'|[^[:space:]\"'#]{20,})" 2>/dev/null \
  | grep -viE "$GEN_EXCL" 2>/dev/null || true)
if [ -n "$gen" ]; then
  report "Generische Credential-Zuweisung (pruefen ob echt)"
  printf '%s\n' "$gen" | cut -c1-160 | sed 's/^/    /'
fi

# --- 3. Persoenliche Denylist (literal, lokal) ------------------------------
DENY="$HOME/.config/git/secret-denylist.local.txt"
if [ -f "$DENY" ]; then
  while IFS= read -r needle; do
    [ -z "$needle" ] && continue
    case "$needle" in \#*) continue;; esac
    if printf '%s\n' "$added" | grep -Fq "$needle" 2>/dev/null; then
      report "Personal-Denylist-Treffer: $needle"
    fi
  done < "$DENY"
fi

# --- Ergebnis ---------------------------------------------------------------
if [ "$violations" -gt 0 ]; then
  printf '\n%s%s%s\n' "$YEL" "$violations Secret-/Credential-Problem(e) in den Staged-Changes. NICHTS wurde committet." "$NC"
  echo  "Fix: Secret entfernen -> env-Variable nutzen / Datei in .gitignore."
  echo  "Falsch-Positiv: 'pragma: allowlist secret' an die Zeile, oder einmalig: git commit --no-verify"
  exit 1
fi
exit 0
